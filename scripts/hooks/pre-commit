#!/usr/bin/env bash
#
# Refuse to build a commit on a protected branch, or under a non-org identity.
#
# These are the cheap, early gates: they fail before the commit object exists,
# so there is nothing to amend or rewrite afterwards. The pre-push hook is the
# one that actually guards what becomes public; these just mean you find out
# now instead of fifteen commits later.
#
set -euo pipefail

root="$(git rev-parse --show-toplevel)"

"$root/scripts/check-branch.sh"
exec "$root/scripts/check-identity.sh" --config
